# Copy to .env.local for local testing. Real values go in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Public: shown to browsers, turns on the "Share to SoundCloud" button.
VITE_SC_CLIENT_ID=

# Server only (used by api/sc-token.ts):
SC_CLIENT_ID=
SC_CLIENT_SECRET=
SC_REDIRECT_URI=https://remixity.vercel.app/sc-callback.html
