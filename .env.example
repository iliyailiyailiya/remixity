# Copy to .env.local for local testing. Real server values go in Cloudflare → Pages project → Settings → Variables and secrets.
# Never commit real values.

# Public: shown to browsers, turns on the "Share to SoundCloud" button.
# Needed at build time: put it in .env.production.local (the site is built locally).
VITE_SC_CLIENT_ID=

# Server only (used by functions/api/sc-token.ts):
SC_CLIENT_ID=
SC_CLIENT_SECRET=
SC_REDIRECT_URI=https://remixity.pages.dev/sc-callback
